<!DOCTYPE html>
<html>
<head>
    <base href="@Request.Url.Scheme://@Request.Url.Authority@Request.ApplicationPath.TrimEnd('/')/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width"/>
    <title>@ViewBag.Title</title>
</head>
<body>
    <div>
        <hr>
        <div class="container full-width col-md-offset-1" id="myWizard">
            <div class="row">
                <div class="col-lg-2 text-center col-md-5 col-sm-12 setup-wizard-title-padding">
                    <h3>
                        <b> Setup Wizard</b>
                    </h3>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <h3>
                        <b class="important-color" id="currentEnvironment" hidden>
                            Current Environment:
                            <span id="currentEnvironmentName"></span>
                        </b>
                    </h3>
                </div>
                <div class="col-lg-2 col-md-2 col-sm-12">
                    <h4>
                        <b class="form-required">* = Required</b>
                    </h4>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-2">
                    <div id="stepList" class="col-lg-12 left-hand-menu">
                        <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                            <a class="nav-link pointer" data-toggle="pill" data-link="/environment" role="tab" aria-selected="true" data-valid="environmentValid">
                                Initial Setup <i class="fa fa-exclamation-triangle  icon-fixed-width  important-color padding-top-five pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" data-link="/credentials" role="tab" aria-selected="false" data-valid="apiCredentialsValid">
                                API Credentials <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" data-link="/appSettings" role="tab" aria-selected="false" data-valid="applicationSettingsValid">
                                Application Settings <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" data-link="/smtp" role="tab" aria-selected="false" data-enabled="campusLogicSection.smtpSettings.notificationsEnabled" data-valid="smtpValid">
                                SMTP <i class="fa fa-exclamation-triangle padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" data-link="/isirUpload" role="tab" aria-selected="false" data-enabled="campusLogicSection.isirUploadSettings.isirUploadEnabled" data-valid="isirUploadValid">
                                ISIR Upload <i class="fa fa-exclamation-triangle padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" data-link="/bulkAction" role="tab" aria-selected="false" data-enabled="campusLogicSection.bulkActionSettings.bulkActionEnabled" data-valid="bulkActionSettingsValid">
                                Bulk Action <i class="fa fa-exclamation-triangle padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/awardLetterUpload" data-enabled="campusLogicSection.awardLetterUploadSettings.awardLetterUploadEnabled" data-valid="awardLetterUploadValid">
                                Communication Upload <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/awardLetterFileMappingUpload" data-enabled="campusLogicSection.fileMappingUploadSettings.fileMappingUploadEnabled" data-valid="fileMappingUploadValid">
                                Communication File Mapping Upload <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/dataFileUpload" data-enabled="campusLogicSection.dataFileUploadSettings.dataFileUploadEnabled" data-valid="dataFileUploadValid">
                                DataFile Uploads <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/documentImports" data-enabled="campusLogicSection.documentImportSettings.enabled" data-valid="documentImportsValid">
                                Document Imports <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/isircorrections" data-enabled="campusLogicSection.isirCorrectionsSettings.correctionsEnabled" data-valid="isirCorrectionsValid">
                                ISIR Corrections <i class="fa fa-exclamation-triangle icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/eventnotifications" data-enabled="campusLogicSection.eventNotificationsEnabled" data-valid="eventNotificationsValid connectionStringValid">
                                Event Notifications <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/document" data-enabled="campusLogicSection.documentSettings.documentsEnabled" data-valid="documentSettingsValid" data-valid-strict>
                                Documents <i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/storedprocedure" data-enabled="campusLogicSection.storedProceduresEnabled" data-valid="storedProcedureValid">
                                Stored Procedure<i class="fa fa-exclamation-triangle  icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/filestore" data-enabled="campusLogicSection.fileStoreSettings.fileStoreEnabled" data-valid="fileStoreSettingsValid">
                                File Store<i class="fa fa-exclamation-triangle icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/awardLetterPrint" data-enabled="campusLogicSection.awardLetterPrintSettings.awardLetterPrintEnabled" data-valid="awardLetterPrintSettingsValid">
                                Communication - Print<i class="fa fa-exclamation-triangle icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/batchprocessing" data-enabled="campusLogicSection.batchProcessingEnabled" data-valid="batchProcessingSettingsValid">
                                Batch Processing<i class="fa fa-exclamation-triangle icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/apiintegration" data-enabled="campusLogicSection.apiIntegrationsEnabled" data-valid="apiIntegrationsValid">
                                API Integration<i class="fa fa-exclamation-triangle icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/filedefinitions" data-enabled="campusLogicSection.fileDefinitionsEnabled" data-valid="fileDefinitionSettingsValid">
                                File Definitions<i class="fa fa-exclamation-triangle icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>
                            <a class="nav-link pointer" data-toggle="pill" role="tab" aria-selected="false" data-link="/powerfaids" data-enabled="campusLogicSection.powerFaidsEnabled" data-valid="powerFaidsSettingsValid">
                                PowerFAIDS<i class="fa fa-exclamation-triangle icon-fixed-width padding-top-five important-color pull-right"></i>
                            </a>

                            <a class="nav-link pointer" data-toggle="pill" data-link="/saveConfigurations" role="tab" aria-selected="false">
                                Save Configurations
                            </a>
                        </div>
                    </div>

                </div>
                <div class="col-lg-9">
                    <div class="tab-content card">
                        <div class="tab-pane fade show active" id="step">
                            <div class="card-body row wizard-tab-container">
                                @RenderBody()
                                <div id="continueBlock" style="text-align: right;" class="col-md-12 padding-top-twenty">
                                    <a class="btn btn-light btn-lg next" id="continueButton">Continue</a>
                                </div>
                                <div id="saveBlock" hidden style="text-align: right;" class="col-md-12 padding-top-twenty">
                                    <a class="btn btn-light btn-lg next" id="saveButton">Save</a>
                                </div>
                            </div>
                            <div class="col-md-12" id="msgInvalidPages" hidden>
                                <p class="important-color">
                                    <b>Please review the sections that have errors, and resolve those issues. </b> <br>
                                    <b>Your configurations cannot be saved until those issues are resolved. </b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgDuplicatePath" hidden>
                                <p class="important-color">
                                    <b>One of your file upload paths has been used twice. </b> <br>
                                    <b>Please ensure all file upload paths are unique. </b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgDuplicateEvent" hidden>
                                <p class="important-color">
                                    <b>You have the same event notification listed twice. </b> <br>
                                    <b>Please ensure only one response has been detailed per event. </b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgInvalidBatchName" hidden>
                                <p class="important-color">
                                    <b>A batch name is incorrect.</b> <br />
                                    <b>Please ensure no batch names are blank or are duplicates of another.</b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgMissingBatchName" hidden>
                                <p class="important-color">
                                    <b>A batch process is missing.</b> <br />
                                    <b>Please check Event Notifications and Batch Processing to ensure both have that batch.</b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgInvalidApiEndpointName" hidden>
                                <p class="important-color">
                                    <b>An API Endpoint name is incorrect.</b> <br />
                                    <b>Please ensure API Endpoint names are not blank.</b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgMissingApiEndpointName" hidden>
                                <p class="important-color">
                                    <b>An API Endpoint is missing.</b> <br />
                                    <b>Please check Event Notifications and API Integration to ensure both have that endpoint.</b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgImproperFileDefinitions" hidden>
                                <p class="important-color">
                                    <b>Missing File Definitions.</b> <br />
                                    <b>Please ensure that a File Definition has been defined for every applicable process.</b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgErrorCopying" hidden>
                                <p class="important-color">
                                    <b>There was an error copying the old Web.config, please check your folder permissions and try again. </b> <br>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgSuccess" hidden>
                                <p class="success-color">
                                    <b>Your configurations were successfully saved, please go back to the home page </b> <br>
                                    <b> to ensure your changes have been applied </b>
                                </p>
                            </div>
                            <div class="col-md-12" id="msgFail" hidden>
                                <p class="important-color">
                                    <b>There was an error while saving your web.config, please try again </b> <br>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
