@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}
<div>
    <h2>
        <b>File Definitions</b>
    </h2>
    <section>
        This step will allow you to configure definitions of file(s) that may be created as part of an event process.
        Examples include creating index files for document imaging, or for file store operations.
        File Definitions may be used multiple times. For additional information see <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_int_cl_cnct_sf_file_defs.html" target="_blank">File Definitions help.</a>
    </section>
    <button type="button" id="addFileDefinition" class="btn btn-light btn-lg pull-right">Add</button>
    <div class="row"><div class="col-lg-12"><hr /></div></div>
    <div class="row">
        <div class="col-lg-12">
            <table class="cl-grid" id="fileDefinitionsGrid">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>File Name Format</th>
                        <th>Include Header Record</th>
                        <th>Extension</th>
                        <th>File Format</th>
                        <th class="cl-grid-commands"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

    </div>
</div>

<template id="fileDefinitionRowTemplate">
    <tr>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="cl-grid-commands">
            <button type="button" class="btn btn-light" data-action="edit" title="Edit"><i class="fa fa-pencil"></i></button>
            <button type="button" class="btn btn-light" data-action="delete" title="Delete"><i class="fa fa-trash"></i></button>
        </td>
    </tr>
</template>
