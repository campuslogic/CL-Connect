@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}

<form name="powerFaidsForm" novalidate>
    <div>
        <h2>
            <b>PowerFAIDS</b>
        </h2>
        <section>
            This step will allow you to configure the output of an XML file compatible with PowerFAIDS.
            The file can either be generated per student or as a batch process to contain multiple students in one file.
            For additional information, see <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_int_cl_cnct_powerfaids_event_nots_sf.html" target="_blank">PowerFAIDS help.</a>
        </section>
        <div class="row"><div class="col-lg-12"><hr /></div></div>
        <!-- File Path -->
        <div class="row">
            <div class="col-lg-12">
                <label class="control-label">File Path</label>
                <cl-folder-picker class="col-lg-7" required data-path="campusLogicSection.powerFaidsSettings.filePath"></cl-folder-picker>
            </div>
        </div>
        <!-- File type -->
        <div class="row" style="margin-top:16px;">
            <div class="col-lg-4 cl-field">
                <label class="control-label">Student(s) per file: </label><br />
                <label class="control-label">
                    <input type="radio" name="campusLogicSection.powerFaidsSettings.isBatch" required value="false" style="width: 20px">One
                </label><br />
                <label class="control-label">
                    <input type="radio" name="campusLogicSection.powerFaidsSettings.isBatch" value="true" style="width: 20px">Multiple
                </label><br />
                <span class="field-validation-error cl-required">Required</span>
            </div>
        </div>
        <!-- Batch Execution Minutes -->
        <div class="row" id="powerFaidsBatchMinutes" style="margin-top:16px;" hidden>
            <div class="col-lg-4">
                <label class="control-label">Batch Execution Minutes:</label>
                <input id="batchExecutionMinutes"
                       name="campusLogicSection.powerFaidsSettings.batchExecutionMinutes"
                       type="number"
                       class="form-control"
                       min="1"
                       step="1"
                       required />
                <span class="field-validation-error cl-required">Required</span>
            </div>
        </div>
        <div class="row"><div class="col-lg-12"><hr /></div></div>
        <div class="row" style="margin-top:16px;">
            <div class="col-lg-12">
                <table class="cl-grid" id="powerFaidsGrid">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Transaction Category</th>
                            <th>Outcome</th>
                            <th>Short Name</th>
                            <th>Required For</th>
                            <th>Status</th>
                            <th>Document Lock</th>
                            <th>Verification Outcome</th>
                            <th>Verification Outcome Lock</th>
                            <th class="cl-grid-commands"></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <span class="field-validation-error" id="powerFaidsNoRecords" hidden>At least one record is required.</span>
                <span class="field-validation-error" id="powerFaidsPairings" hidden>Please ensure all Event/Transaction Category pairings are defined and unique and Events are accounted for in Event Notifications.</span>
            </div>
            <div class="col-lg-12" style="margin-top:8px;">
                <button type="button" id="addPowerFaidsRecord" class="btn btn-light">Add</button>
            </div>
        </div>
    </div>
</form>

<template id="powerFaidsRowTemplate">
    <tr>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="cl-grid-commands">
            <button type="button" class="btn btn-light" data-action="edit" title="Edit"><i class="fa fa-pencil"></i></button>
            <button type="button" class="btn btn-light" data-action="delete" title="Delete"><i class="fa fa-trash"></i></button>
        </td>
    </tr>
</template>
