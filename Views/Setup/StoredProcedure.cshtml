@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}

<div class="form-horizontal" name="storedprocedureForm">
    <h2>
        <b>Stored Procedure Setting</b>
    </h2>
    This step is for configuring custom Stored Procedures to associate to Event Notifications. You can have one or many, but if you have enabled this feature at least one Stored Procedure is required.
    If you previously used the default Stored Procedure, you will not need to configure it through this step. Two stored procedures' name should not be same. If the parameter's data type is integer, the length is unnecessary.
    For further detail on the Stored Procedure configurations section please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_configure_event_notifications_and_stored_procedures.html" target="_blank">Stored Procedure Help.</a>
    <hr>
    <div class="row form-group mb-3">
        <div class="col-lg-8">
            <label class="control-label col-lg-4"><span class="form-required" aria-hidden="true">* </span> Stored Procedure Name</label>
            <div class="col-lg-6">
                <input type="text" class="form-control" id="storedProcedureName" name="storedProcedureName" />
                <span id="duplicateStoredProcedure" hidden>You cannot add two stored procedures with same name.</span>
                <div class="padding-top-twenty">
                    <button type="button" id="addStoredProcedure" class="btn btn-light pull-right" disabled>Add Stored Procedure</button>
                </div>
            </div>
        </div>
    </div>
    <div id="storedProcedureList"></div>
    <span class="field-validation-error" id="noStoredProcedures" hidden>At least one Stored Procedure is required.</span>
</div>

<template id="storedProcedureTemplate">
    <div data-stored-procedure-index>
        <div class="col-lg-12">
            <h3><b>Stored Procedure Name: <span class="cl-stored-procedure-name"></span></b> <i class="fa fa-trash-o pointer padding-left-fifteen" aria-hidden="true" data-action="delete-stored-procedure"></i>
            </h3>
            <p>Please note that the order of the parameters added here must match the exact order of your stored procedure(type and order identify the parameter, not name).</p>
        </div>
        <div class="col-lg-12">
            <label class="control-label">Parameter values</label>
        </div>
        <div class="col-lg-12 padding-bottom-ten">
            <table class="cl-grid">
                <thead>
                    <tr>
                        <th style="width: 270px">Name</th>
                        <th>Data Type</th>
                        <th>Length</th>
                        <th>Source</th>
                        <th class="cl-grid-commands" style="width: 20%"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
            <div class="row padding-top-ten">
                <div class="col-lg-12">
                    <button type="button" class="btn btn-light" data-action="add-parameter">Add</button>
                </div>
            </div>
        </div>
    </div>
</template>

<template id="parameterRowTemplate">
    <tr>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="cl-grid-commands">
            <button type="button" class="btn btn-light" data-action="edit-parameter"><i class="fa fa-pencil"></i></button>
            <button type="button" class="btn btn-light" data-action="delete-parameter"><i class="fa fa-trash"></i></button>
        </td>
    </tr>
</template>
