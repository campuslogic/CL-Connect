@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}

<form name="environmentForm" novalidate>
    <h2><b>Initial Setup</b></h2>
    <p>
        For further information on the CL Connect wizard please see this<a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/c_campuslogic_integration_with_cl_connect.html" target="_blank">overview</a>.
    </p>
    <hr>
    <div class="col-md-12 padding-top-ten">
        <div class="row">
            <div class="col-md-6 cl-field">
                <h4>
                    <span class="form-required" aria-hidden="true">*</span>
                    <b> What environment would you like to set up?</b>
                </h4>
                <div class="col-md-10">
                    <select id="environmentdropdown" name="appSettingsSection.environment" required class="form-select">
                        <option value="sandbox">Sandbox</option>
                        <option value="production">Production</option>
                        <option value="production-ca">Production (Canada)</option>
                    </select>
                </div>
                <div class="col-md-10">
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="col-md-6">
                <h4>
                    <span class="form-required" aria-hidden="true">*</span>
                    <b>Which configurations would you like to enable?</b>
                </h4>
                <div class="col-md-12">
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="smtp" data-page-valid="smtpValid" name="campusLogicSection.smtpSettings.notificationsEnabled">
                        <label class="k-checkbox-label" for="smtp" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables emails to be sent for automation errors">SMTP</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="isirUpload" data-page-valid="isirUploadValid" name="campusLogicSection.isirUploadSettings.isirUploadEnabled">
                        <label class="k-checkbox-label" for="isirUpload" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Automates ISIR upload">ISIR Uploads</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="bulkActions" data-page-valid="bulkActionsValid" name="campusLogicSection.bulkActionSettings.bulkActionEnabled" />
                        <label class="k-checkbox-label" for="bulkActions" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables Bulk Actions">Bulk Actions</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="awardLetterUpload" data-page-valid="awardLetterUploadValid" name="campusLogicSection.awardLetterUploadSettings.awardLetterUploadEnabled">
                        <label class="k-checkbox-label" for="awardLetterUpload" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Automates Communication data file upload">Communication Uploads</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="fileMappingUpload" data-page-valid="fileMappingUploadValid" name="campusLogicSection.fileMappingUploadSettings.fileMappingUploadEnabled">
                        <label class="k-checkbox-label" for="fileMappingUpload" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Automates Communication file mapping upload">Communication File Mapping Uploads</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="dataFileUpload" data-page-valid="dataFileUploadValid" name="campusLogicSection.dataFileUploadSettings.dataFileUploadEnabled">
                        <label class="k-checkbox-label" for="dataFileUpload" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Automates Data File (SIS, scholarship, etc) uploads">DataFile Uploads</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="documentImports" data-page-valid="documentImportsValid" name="campusLogicSection.documentImportSettings.enabled">
                        <label class="k-checkbox-label" for="documentImports" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables ability to import student documents into StudentVerification">Document Imports</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" id="isirBatchCorrections" class="k-checkbox" data-page-valid="isirCorrectionsValid" name="campusLogicSection.isirCorrectionsSettings.correctionsEnabled">
                        <label class="k-checkbox-label" for="isirBatchCorrections" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Automates ISIR Batch Corrections">ISIR Batch Corrections</label>
                    </div>
                    <div class="padding-five">
                        <input type="checkbox" class="k-checkbox" id="eventNotifications" data-page-valid="eventNotificationsValid" name="campusLogicSection.eventNotificationsEnabled">
                        <label class="k-checkbox-label" for="eventNotifications" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables notifications and processing of events(task completed, document submitted etc.)">Event Notifications</label>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="documentImaging" data-page-valid="documentSettingsValid" data-sub-check name="campusLogicSection.documentSettings.documentsEnabled">
                            <label class="k-checkbox-label" for="documentImaging" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables document specific notifications and processing">Documents</label>
                        </div>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="storedProcedure" data-page-valid="storedProcedureValid" data-sub-check name="campusLogicSection.storedProceduresEnabled" />
                            <label class="k-checkbox-label" for="storedProcedure" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables configurable procedure">Stored Procedure</label>
                        </div>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="fileStore" data-page-valid="fileStoreSettingsValid" data-sub-check name="campusLogicSection.fileStoreSettings.fileStoreEnabled" />
                            <label class="k-checkbox-label" for="fileStore" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables file store configuration">File Store</label>
                        </div>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="awardLetterPrint" data-page-valid="awardLetterPrintSettingsValid" data-sub-check name="campusLogicSection.awardLetterPrintSettings.awardLetterPrintEnabled" />
                            <label class="k-checkbox-label" for="awardLetterPrint" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables print configuration for Communications">Communication Print</label>
                        </div>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="batchProcessing" data-page-valid="batchProcessingSettingsValid" data-sub-check name="campusLogicSection.batchProcessingEnabled" />
                            <label class="k-checkbox-label" for="batchProcessing" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables batch processing handling for multiple events">Batch Processing</label>
                        </div>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="apiIntegration" data-page-valid="apiIntegrationsValid" data-sub-check name="campusLogicSection.apiIntegrationsEnabled" />
                            <label class="k-checkbox-label" for="apiIntegration" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables API integration">API Integration</label>
                        </div>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="fileDefinitions" data-page-valid="fileDefinitionSettingsValid" data-sub-check name="campusLogicSection.fileDefinitionsEnabled" />
                            <label class="k-checkbox-label" for="fileDefinitions" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables File Definitions">File Definitions</label>
                        </div>
                        <div class="sub-check-box">
                            <input type="checkbox" class="k-checkbox" id="powerFaids" data-page-valid="powerFaidsSettingsValid" data-sub-check name="campusLogicSection.powerFaidsEnabled" />
                            <label class="k-checkbox-label" for="powerFaids" data-toggle="tooltip" data-trigger="mouseenter" data-placement="right" title="Enables PowerFAIDS">PowerFAIDS</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
