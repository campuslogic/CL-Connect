<div class="cl-folder-picker-body cl-field">
    <div class="row">
        <div class="col-lg-9">
            <input class="input-lg col-lg-12" type="text" aria-label="Folder path" />
            <div class="pull-right">
                <span class="field-validation-error cl-required">Required</span>
                <span class="field-validation-error cl-path-not-unique" hidden>All folder paths must be unique across all sections.</span>
            </div>
        </div>
        <div class="col-lg-3">
            <button class="btn btn-light btn-lg" type="button" data-action="browse">Select</button>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="pull-left">
                <button class="btn btn-light btn-lg" type="button" data-action="test">Test</button>
                <span class="alert alert-success cl-path-valid" role="alert" hidden>Path is valid</span>
                <span class="alert alert-danger cl-path-invalid" role="alert" hidden>Invalid Path</span>
            </div>
        </div>
    </div>
    <div class="padding-top-twenty"></div>
</div>
