
<div class="modal-header"><h4 id="apiIntegrationModalTitle"></h4></div>
<div class="modal-body">
    <form id="apiIntegrationModalForm" novalidate>
        <div class="row padding-bottom-ten">
            <div class="col-lg-4 text-right">
                <label class="control-label">API Name</label>
            </div>
            <div class="col-lg-8">
                <input type="text" class="form-control" id="apiName" name="apiIntegration.apiName" required />
                <span class="field-validation-error" id="apiNameRequired" hidden>Required</span>
                <span class="field-validation-error" id="apiNameDuplicate" hidden>Name must be unique</span>
            </div>
        </div>
        <div class="row padding-bottom-ten">
            <div class="col-lg-4 text-right">
                <label class="control-label">Authentication</label>
            </div>
            <div class="col-lg-8">
                <select id="method" required class="form-select" name="apiIntegration.authentication">
                    <option value="none">None</option>
                    <option value="basic">Basic</option>
                    <option value="oauth2">OAuth 2.0</option>
                    <option value="oauth_wrap">OAuth WRAP</option>
                    <option value="ethos" id="ethosOption">Ethos Authentication</option>
                </select>
            </div>
        </div>
        <div class="row padding-bottom-ten">
            <div class="col-lg-4 text-right">
                <label class="control-label">Root</label>
            </div>
            <div class="col-lg-8">
                <input type="text" class="form-control" id="root" name="apiIntegration.root" required />
                <span class="field-validation-error" id="apiRootInvalid" hidden>Root must begin with "http://" or "https://"</span>
            </div>
        </div>
        <div class="row padding-bottom-ten" id="tokenServiceRow" hidden>
            <div class="col-lg-4 text-right">
                <label class="control-label">Token Service</label>
            </div>
            <div class="col-lg-8">
                <input type="text" class="form-control" id="tokenService" name="apiIntegration.tokenService" required />
                <span class="field-validation-error" id="apiTokenInvalid" hidden>Token must begin with "http://" or "https://"</span>
            </div>
        </div>
        <div class="row padding-bottom-ten" id="usernameRow" hidden>
            <div class="col-lg-4 text-right">
                <label class="control-label" id="usernameLabelUsername" hidden>Username</label>
                <label class="control-label" id="usernameLabelClientId" hidden>Client ID</label>
            </div>
            <div class="col-lg-8">
                <input type="text" class="form-control" id="username" name="apiIntegration.username" required />
                <span class="field-validation-error" id="apiUsernameRequired" hidden>Required</span>
            </div>
        </div>
        <div class="row padding-bottom-ten" id="passwordRow" hidden>
            <div class="col-lg-4 text-right">
                <label class="control-label" id="passwordLabelPassword" hidden>Password</label>
                <label class="control-label" id="passwordLabelClientSecret" hidden>Client Secret</label>
                <label class="control-label" id="passwordLabelApiKey" hidden>API Key</label>
            </div>
            <div class="col-lg-8">
                <input type="password" class="form-control" id="password" name="apiIntegration.password" required />
                <span class="field-validation-error" id="apiPasswordRequired" hidden>Required</span>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <input type="button" id="button-field-search-cancel" class="btn btn-light" value="Cancel" data-action="cancel" />
    <input type="button" id="button-field-search-save" class="btn btn-primary" value="Save" data-action="save" />
</div>
