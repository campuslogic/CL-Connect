@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}

<form class="form-horizontal" data-toggle="validator" name="isircorrectionForm" novalidate>
    <h2>
        <b>ISIR Batch Corrections</b>
    </h2>
    <section>
        <p>
        This step will allow you to select the configurations for the ISIR Batch Corrections process.
        If the file path you wish to use is not available for selection, you may also enter the path below.
        For assistance in giving appropriate file path permissions, please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_set_file_permissions.html" target="_blank">File Path Permissions.</a>
        For further detail on the ISIR Batch Corrections section please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_set_up_isir_corrections.html" target="_blank">ISIR Batch Corrections Detail.</a>
    </section>
    <hr>
    <div class="row padding-bottom-ten">
        <div class="row padding-top-ten">
            <div class="col-lg-5">
                <div class="row form-group mb-3">
                    <label class="col-lg-5 control-label"><span class="form-required" aria-hidden="true">* </span>Days to Run</label>
                    <div class="col-lg-7">
                        <cl-days-picker name="isirCorrectionsDaysToRun" data-path="campusLogicSection.isirCorrectionsSettings.daysToRun"></cl-days-picker>
                        <span class="field-validation-error cl-days-required" hidden>Required</span>
                    </div>
                </div>
                <div class="row form-group mb-3 padding-top-twenty">
                    <label class="col-lg-5 control-label"><span class="form-required" aria-hidden="true">* </span>Time to Run (UTC)</label>
                    <div class="col-lg-4">
                        <input class="padding-bottom-seven form-control" required pattern="^([0-9]|0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]+(AM|PM|am|pm)$" id="timeToRun" name="campusLogicSection.isirCorrectionsSettings.timeToRun" list="clTimesOfDay">
                        <datalist id="clTimesOfDay">
                            <option value="12:00AM"></option>
                            <option value="12:30AM"></option>
                            <option value="01:00AM"></option>
                            <option value="01:30AM"></option>
                            <option value="02:00AM"></option>
                            <option value="02:30AM"></option>
                            <option value="03:00AM"></option>
                            <option value="03:30AM"></option>
                            <option value="04:00AM"></option>
                            <option value="04:30AM"></option>
                            <option value="05:00AM"></option>
                            <option value="05:30AM"></option>
                            <option value="06:00AM"></option>
                            <option value="06:30AM"></option>
                            <option value="07:00AM"></option>
                            <option value="07:30AM"></option>
                            <option value="08:00AM"></option>
                            <option value="08:30AM"></option>
                            <option value="09:00AM"></option>
                            <option value="09:30AM"></option>
                            <option value="10:00AM"></option>
                            <option value="10:30AM"></option>
                            <option value="11:00AM"></option>
                            <option value="11:30AM"></option>
                            <option value="12:00PM"></option>
                            <option value="12:30PM"></option>
                            <option value="01:00PM"></option>
                            <option value="01:30PM"></option>
                            <option value="02:00PM"></option>
                            <option value="02:30PM"></option>
                            <option value="03:00PM"></option>
                            <option value="03:30PM"></option>
                            <option value="04:00PM"></option>
                            <option value="04:30PM"></option>
                            <option value="05:00PM"></option>
                            <option value="05:30PM"></option>
                            <option value="06:00PM"></option>
                            <option value="06:30PM"></option>
                            <option value="07:00PM"></option>
                            <option value="07:30PM"></option>
                            <option value="08:00PM"></option>
                            <option value="08:30PM"></option>
                            <option value="09:00PM"></option>
                            <option value="09:30PM"></option>
                            <option value="10:00PM"></option>
                            <option value="10:30PM"></option>
                            <option value="11:00PM"></option>
                            <option value="11:30PM"></option>
                        </datalist>
                        <span class="field-validation-error" id="timeToRunRequired" hidden>Required</span>
                        <span class="field-validation-error" id="timeToRunFormat" hidden>Format is incorrect, format must be: hh:mmtt</span>
                    </div>
                </div>
                <div class="row form-group mb-3 padding-top-twenty">
                    <label class="col-lg-5 control-label"><span class="form-required" aria-hidden="true">* </span>File Extension</label>
                    <div class="col-lg-3">
                        <select class="form-select" name="campusLogicSection.isirCorrectionsSettings.fileExtension" style="height: 34px">
                            <option style="height: 34px" value="txt">txt</option>
                            <option style="height: 34px" value="dat">dat</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="row form-group mb-3">
                    <label class="col-lg-3 control-label no-gutter"><span class="form-required" aria-hidden="true">*</span>Corrections File Path</label>
                    <cl-folder-picker class="col-lg-9" required data-path="campusLogicSection.isirCorrectionsSettings.correctionsFilePath"></cl-folder-picker>
                </div>
                <div class="row form-group mb-3">
                    <label class="col-lg-3 control-label no-gutter">File Name</label>
                    <div class="col-lg-7">
                        <input name="campusLogicSection.isirCorrectionsSettings.fileName" type="text" class="form-control">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12 padding-left-10 padding-right-10"><hr/>
        </div>
    </div>
    <div class="row padding-bottom-ten">
        <div class="col-lg-3">
            <label>TDClient Integration Enabled:</label>
        </div>
        <div class="col-lg-3">
            <input type="radio" name="campusLogicSection.isirCorrectionsSettings.tdClientEnabled" value="true" style="width: 20px"><strong>True</strong>
            <input type="radio" name="campusLogicSection.isirCorrectionsSettings.tdClientEnabled" value="false" style="width: 20px"><strong>False</strong>
        </div>
    </div>
    <div id="tdClientSection" hidden>
        <div class="row padding-bottom-ten">
            <div class="col-lg-7">
                <label>TDClient Executable Path:<button type="button" class="cl-help" popovertarget="tdClientExecutablePath.html" aria-label="Help"><i class="fa fa-question-circle"></i></button></label>
                <cl-folder-picker class="col-lg-9" required data-path="campusLogicSection.isirCorrectionsSettings.tdClientExecutablePath"></cl-folder-picker>
            </div>
            <div class="col-lg-5">
                <label>TDClient secfile Folder/Relative Path:<button type="button" class="cl-help" popovertarget="tdClientSecfileFolderPath.html" aria-label="Help"><i class="fa fa-question-circle"></i></button></label>
                <input required name="campusLogicSection.isirCorrectionsSettings.tdClientSecfileFolderPath" type="text" class="form-control">
            </div>
        </div>
        <div class="row padding-bottom-ten">
            <div class="col-lg-7">
                <label>Archive File Path<button type="button" class="cl-help" popovertarget="tdClientArchiveFilePath.html" aria-label="Help"><i class="fa fa-question-circle"></i></button></label>
                <cl-folder-picker class="col-lg-9" required data-path="campusLogicSection.isirCorrectionsSettings.tdClientArchiveFilePath"></cl-folder-picker>
            </div>
            <div class="col-lg-5">
                <div class="row padding-bottom-ten">
                    <div class="col-lg-12">
                        <label class="control-label">Name of Transfer: (ex: john.doe.fsa)<button type="button" class="cl-help" popovertarget="tdClientFtpUsername.html" aria-label="Help"><i class="fa fa-question-circle"></i></button></label>
                        <input name="campusLogicSection.isirCorrectionsSettings.tdClientFtpUsername" type="text" class="form-control">
                    </div>
                </div>
                <div class="row padding-bottom-ten">
                    <div class="col-lg-12">
                        <label class="control-label">Sender Mailbox User ID: (ex: TGxxxxx or FTxxxxx)<button type="button" class="cl-help" popovertarget="tdClientFtpUserId.html" aria-label="Help"><i class="fa fa-question-circle"></i></button></label>
                        <input name="campusLogicSection.isirCorrectionsSettings.tdClientFtpUserId" type="text" class="form-control">
                    </div>
                </div>
                <div class="row padding-bottom-ten">
                    <div class="col-lg-12">
                        <label class="control-label">Recipient Mailbox User ID: (ex: TGxxxxx or FTxxxxx)<button type="button" class="cl-help" popovertarget="tdClientFtpRecipientUserId.html" aria-label="Help"><i class="fa fa-question-circle"></i></button></label>
                        <input name="campusLogicSection.isirCorrectionsSettings.tdClientFtpRecipientUserId" type="text" class="form-control">
                    </div>
                </div>
                <div class="row padding-bottom-ten">
                    <div class="col-lg-12">
                        <label class="control-label">Network<button type="button" class="cl-help" popovertarget="tdClientNetwork.html" aria-label="Help"><i class="fa fa-question-circle"></i></button></label>
                        <input name="campusLogicSection.isirCorrectionsSettings.tdClientNetwork" type="text" class="form-control">
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>



<div class="cl-popover" popover id="tdClientExecutablePath.html">
    <div>
        The location of the tdclientc.exe file.
    </div>
</div>

<div class="cl-popover" popover id="tdClientSecfileFolderPath.html">
    <div>
        The location of the TdClient secfile file. This can be a relative or absolute path.
        PLEASE NOTE: No spacing is allowed in this path. There is also no validation on this path for
        permissions because it can also be relative.
    </div>
</div>

<div class="cl-popover" popover id="tdClientArchiveFilePath.html">
    <div>
        The location where isir correction files will be placed for archiving once they are sent to TdClient.
    </div>
</div>

<div class="cl-popover" popover id="tdClientFtpUsername.html">
    <div>
        This names the transfer being created.
    </div>
</div>

<div class="cl-popover" popover id="tdClientFtpUserId.html">
    <div>
        SENDUSERID is a required parm in the Transfer command line. You must use a valid TG ID as a place holder in this field. Using your own TG ID is highly recommended.
    </div>
</div>

<div class="cl-popover" popover id="tdClientNetwork.html">
    <div>
        NETWORK is a required parm in the TD Client for specifying SAIG TDClient or FTI-SAIG TDClient.
    </div>
</div>

<div class="cl-popover" popover id="tdClientFtpRecipientUserId.html">
    <div>
        The Mailbox ID of who is to receive the data when you are sending. See application-specific guides and references for the correct destination mailbox for each message class.
    </div>
</div>
