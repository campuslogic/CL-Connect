@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}

<form class="form-horizontal" name="formAppSettings" novalidate>
    <h2><b>Application Settings</b></h2>
    <p>
        This step will allow you to change global application settings for CL Connect.
        For further detail on the application settings section please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_setup_api_credentials.html" target="_blank">Application Settings Help.</a>
    </p>
    <hr>
    <div class="row padding-top-ten">
        <div class="col-lg-6">
            <label>Data purge thresholds</label>
            <p>These settings help control when data is removed from the local data store, please enter in days. </p>
            <div class="row form-group mb-3">
                <label class="control-label col-lg-4" for="inputPurgeReceivedEventsAfterDays"><span class="form-required" aria-hidden="true">*</span> Events</label>
                <div class="col-lg-3">
                    <input type="number" class="form-control" id="inputPurgeReceivedEventsAfterDays" name="appSettingsSection.purgeReceivedEventsAfterDays" min="1" max="365" step="1" required />
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="control-label col-lg-4" for="inputPurgeLogRecordsAfterDays"><span class="form-required" aria-hidden="true">*</span> Logs</label>
                <div class="col-lg-3">
                    <input type="number" class="form-control" id="inputPurgeLogRecordsAfterDays" name="appSettingsSection.purgeLogRecordsAfterDays" min="1" max="365" step="1" required />
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="control-label col-lg-4" for="inputPurgeNotificationLogRecordsAfterDays"><span class="form-required" aria-hidden="true">*</span> Notifications</label>
                <div class="col-lg-3">
                    <input type="number" class="form-control" id="inputPurgeNotificationLogRecordsAfterDays" name="appSettingsSection.purgeNotificationLogRecordsAfterDays" min="1" max="365" step="1" required />
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <label>Worker process</label>
            <p>These settings control the worker process which executes incoming requests.</p>
            <div class="row form-group mb-3">
                <label class="control-label col-lg-4" for="inputBackgroundWorkerCount"><span class="form-required" aria-hidden="true">*</span> Worker Count</label>
                <div class="col-lg-3">
                    <input type="number" class="form-control" id="inputBackgroundWorkerCount" name="appSettingsSection.backgroundWorkerCount" min="1" max="5" step="1" required />
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="control-label col-lg-4" for="inputBackgroundWorkerRetryAttempts"><span class="form-required" aria-hidden="true">*</span> Retry Attempts</label>
                <div class="col-lg-3">
                    <input type="number" class="form-control" id="inputBackgroundWorkerRetryAttempts" name="appSettingsSection.backgroundWorkerRetryAttempts" min="1" max="20" step="1" required />
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
        </div>
    </div>
    <div class="row padding-top-twenty">
        <div class="col-lg-6">
            <label>Incoming API</label>
            <p>These settings are used for authenticating incoming request from the CampusLogic servers.</p>
            <div class="row form-group mb-3">
                <label class="control-label col-lg-4" for="inputIncomingApiUsername"><span class="form-required" aria-hidden="true">*</span> Username</label>
                <div class="col-lg-8">
                    <input type="text" class="form-control" id="inputIncomingApiUsername" name="appSettingsSection.incomingApiUsername" required />
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="control-label col-lg-4" for="inputIncomingApiPassword"><span class="form-required" aria-hidden="true">*</span> Password</label>
                <div class="col-lg-8">
                    <input type="password" class="form-control" id="inputIncomingApiPassword" name="appSettingsSection.incomingApiPassword" required />
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
        </div>
    </div>
</form>
