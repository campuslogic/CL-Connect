@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}
<form class="form-horizontal" name="awardLetterFileMappingUploadForm" novalidate>
    <h2>
        <b>Communication File Mapping Upload</b>
    </h2>
    <section>
        This step will allow you to select the configurations for the Communication File Mapping Upload process.
        If the file path you wish to use is not available for selection, you may also enter the path below.
        For assistance in giving appropriate file path permissions, please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_set_file_permissions.html" target="_blank">File Path Permissions.</a>
        @*For further detail on the Communication Upload section please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_configure_cc_uploads.html/" target="_blank">Communication Upload Details.</a>*@
    </section>
    <hr>
    <div class="row padding-top-ten">
        <div class="col-lg-5">
            <div class="row form-group mb-3">
                <label class="col-lg-5 control-label"><span class="form-required" aria-hidden="true">* </span>Upload Frequency</label>
                <div class="col-lg-7 ">
                    <select required class="form-select" name="campusLogicSection.fileMappingUploadSettings.fileMappingUploadFrequencyType">
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="minutes">Minutely</option>
                        <option value="hourly">Hourly</option>
                    </select>
                </div>
            </div>
            <div class="row form-group mb-3 padding-top-one-hundred">
                <label class="col-lg-5 control-label"><span class="form-required" aria-hidden="true">* </span>Days to Run</label>
                <div class="col-lg-7 ">
                    <cl-days-picker name="fileMappingUploadDaysToRun" data-path="campusLogicSection.fileMappingUploadSettings.fileMappingUploadDaysToRun"></cl-days-picker>
                    <span class="field-validation-error cl-days-required" hidden>Required</span>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="row form-group mb-3">
                <label class="col-lg-3 control-label "><span class="form-required" aria-hidden="true">* </span>Upload Path</label>
                <cl-folder-picker class="col-lg-7" required data-path="campusLogicSection.fileMappingUploadSettings.fileMappingUploadFilePath"></cl-folder-picker>
            </div>
            <div class="row form-group mb-3">
                <label class="col-lg-3 control-label "><span class="form-required" aria-hidden="true">* </span>Archive Path</label>
                <cl-folder-picker class="col-lg-7" required data-path="campusLogicSection.fileMappingUploadSettings.fileMappingArchiveFilePath"></cl-folder-picker>
            </div>
        </div>
    </div>
</form>

