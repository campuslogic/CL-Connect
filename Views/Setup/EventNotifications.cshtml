@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}
<form class="form-horizontal" name="formEventNotifications" novalidate>
    <h2><b>Event Notifications</b></h2>
    <p>
        This step will help you configure which incoming events you would like to act on. For each event you would like to respond to create an entry below and populate the necessary fields.
        Event id's are documented <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/c_event_notif_defs.html" target="_blank">Event Notification Detail.</a>
        For further detail on the Event Notifications section please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/c_event_notif_overview.html" target="_blank">Event Notification Help.</a>
    </p>
    <hr>
    <div class="padding-top-twenty">
        <p>Events to respond to</p>
        <div id="eventNotificationRows"></div>
        <div>
            <a href="" id="addEventNotification" class="pull-right">Add another event</a>
        </div>
    </div>
    <div class="padding-top-ten">
        <div id="duplicateEvent" hidden>
            <span class="alert alert-danger" role="alert">Events can only be responded to once, please delete duplicate event.</span>
        </div>
        <div style="padding-top:36px;" id="invalidBatchName" hidden>
            <span class="alert alert-danger" role="alert">Batch names cannot be blank or used more than once, please correct the batch process.</span>
        </div>
        <div style="padding-top:36px;" id="invalidApiEndpointName" hidden>
            <span class="alert alert-danger" role="alert">API Endpoint names cannot be blank.</span>
        </div>
    </div>
    <div class="padding-top-twenty">
        <label>Database Connection</label>
        <p>Enter the connection details to use when executing database commands.</p>
        <div class="row form-group mb-3">
            <label class="col-lg-3 control-label">Connection Type</label>
            <div class="col-lg-9">
                <select id="connectionStringType" class="form-select" name="connectionStringType">
                    <option value="n">None</option>
                    <option value="c">Connection string</option>
                    <option value="d">DSN</option>
                </select>
            </div>
        </div>
        <div id="connectionStringFields" hidden>
            <div class="row form-group mb-3">
                <label class="col-lg-3 control-label">Connection String</label>
                <div class="col-lg-9">
                    <input type="text" class="form-control" id="inputConnectionString" placeholder="Connection string" name="campusLogicSection.clientDatabaseConnection.connectionString" />
                </div>
            </div>
        </div>
        <div id="dsnFields" hidden>
            <div class="row form-group mb-3">
                <label class="col-lg-3 control-label">DSN Name</label>
                <div class="col-lg-9">
                    <input type="text" class="form-control" placeholder="DSN Name" id="dsnName" name="dsnName" />
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="col-lg-3 control-label">DSN Username</label>
                <div class="col-lg-9">
                    <input type="text" class="form-control" placeholder="DSN Username" id="dsnUser" name="dsnUser" />
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="col-lg-3 control-label">DSN Password</label>
                <div class="col-lg-9">
                    <input type="password" class="form-control" placeholder="DSN Password" id="dsnPassword" name="dsnPassword" />
                </div>
            </div>
        </div>
        <div class="row form-group mb-3" id="testConnectionRow" hidden>
            <div class="col-lg-9 offset-lg-3">
                <button type="button" id="testConnectionString" class="btn btn-light btn-lg full-width">Test database connection</button>
                <span class="alert alert-success" role="alert" id="connectionTestPassed" hidden>Test Successful</span>
                <span class="alert alert-danger" role="alert" id="connectionTestFailed" hidden>Error Testing Connection String</span>
            </div>
        </div>
        <div>
            <span class="alert alert-danger" role="alert" id="connectionRequired" hidden>A connection string or DSN needs to be established.</span>
        </div>
    </div>
</form>

<template id="eventNotificationRowTemplate">
    <div class="row form-group mb-3" data-event-index>
        <div class="col-lg-4">
            <select class="form-select cl-event-id"></select>
        </div>
        <div class="col-lg-2">
            <select class="form-select cl-handle-method"></select>
        </div>
        <div class="col-lg-2">
            <select class="form-select cl-file-store-type" hidden disabled>
                <option value="Shared">Shared</option>
                <option value="Individual">Individual</option>
            </select>
            <input class="form-control cl-batch-name" placeholder="Batch Name" hidden disabled />
            <input class="form-control cl-api-endpoint-name" placeholder="Endpoint Name" hidden disabled />
        </div>
        <div class="col-lg-3">
            <input class="form-control cl-db-command" placeholder="Database Command" />
            <span class="field-validation-error cl-required">Required</span>
        </div>
        <div class="col-lg-1">
            <button type="button" class="btn btn-light cl-remove-event" data-action="remove-event"><i class="fa fa-remove"></i></button>
        </div>
    </div>
</template>
