@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}
<form name="fileStoreForm" novalidate>
    <h2>
        <b>File Store Settings</b>
    </h2>
    <section>
        This step will allow you to configure File Store options.
        If the path you wish to use is not available for selection, you may also enter the path below. For additional information, please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_set_file_permissions.html" target="_blank">File Path Permissions.</a>
        For additional help on this page please see <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_int_event_notes_file_store.html" target="_blank">File Store Help.</a>
    </section>
    <hr>
    <div class="alert alert-danger cl-step-error" role="alert" id="stepError" hidden></div>
    <div class="row padding-bottom-ten">
        <div class="col-lg-8">
            <div class="form-group">
                <label><span class="form-required" aria-hidden="true">*</span>File Store Path</label>
                <cl-folder-picker class="col-lg-7" required data-path="campusLogicSection.fileStoreSettings.fileStorePath"></cl-folder-picker>
            </div>
        </div>
    </div>
    <div class="row padding-bottom-ten">
        <div class="col-lg-8">
            <label class="control-label" for="fileStoreMinutes"><span class="form-required" aria-hidden="true">*</span>File Store Minutes</label><br />
            <div class="col-lg-2">
                <input type="number" id="fileStoreMinutes" name="campusLogicSection.fileStoreSettings.fileStoreMinutes" min="1" step="1" required /><br />
                <span class="field-validation-error cl-required">Required</span>
            </div>
        </div>
    </div>
    <div class="row padding-bottom-ten"></div>
    <div class="row padding-bottom-ten">
        <div class="col-lg-8">
            <label class="control-label" for="fileDefinitionName"><span class="form-required" aria-hidden="true">*</span>File Definition Name</label><br />
            <input type="text" id="fileDefinitionName" name="campusLogicSection.fileStoreSettings.fileDefinitionName" required /><br />
            <span class="field-validation-error cl-required">Required</span>
        </div>
    </div>
</form>
