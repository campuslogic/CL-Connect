@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}
<div>
    <h2>
        <b>File Store Settings</b>
    </h2>
    <section>
        This step will allow you to configure File Store options. Add a file store for each destination you
        want events written to, then choose which store each event uses on the Event Notifications step.
        For additional information, please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_set_file_permissions.html" target="_blank">File Path Permissions.</a>
        For additional help on this page please see <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_int_event_notes_file_store.html" target="_blank">File Store Help.</a>
    </section>
    <button type="button" id="addFileStore" class="btn btn-light btn-lg pull-right">Add</button>
    <div class="row"><div class="col-lg-12"><hr /></div></div>
    <div class="alert alert-danger cl-step-error" role="alert" id="stepError" hidden></div>
    <div class="row">
        <div class="col-lg-12">
            <table class="cl-grid" id="fileStoresGrid">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>File Store Path</th>
                        <th>File Store Minutes</th>
                        <th>File Definition Name</th>
                        <th class="cl-grid-commands"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<template id="fileStoreRowTemplate">
    <tr>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="cl-grid-commands">
            <button type="button" class="btn btn-light" data-action="edit" title="Edit"><i class="fa fa-pencil"></i></button>
            <button type="button" class="btn btn-light" data-action="delete" title="Delete"><i class="fa fa-trash"></i></button>
        </td>
    </tr>
</template>
