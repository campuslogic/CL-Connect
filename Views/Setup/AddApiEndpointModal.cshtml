
<div class="modal-header"><h4 id="apiEndpointModalTitle"></h4></div>
<div class="modal-body">
    <form id="apiEndpointModalForm" novalidate>
        <div class="row padding-bottom-ten">
            <div class="col-lg-3 text-right">
                <label class="control-label">Name</label>
            </div>
            <div class="col-lg-9">
                <input type="text" class="form-control" id="name" name="apiEndpoint.name" required />
                <span class="field-validation-error" id="endpointNameRequired" hidden>Required</span>
                <span class="field-validation-error" id="endpointNameDuplicate" hidden>Name must be unique</span>
            </div>
        </div>
        <div class="row padding-bottom-ten">
            <div class="col-lg-3 text-right">
                <label class="control-label">Endpoint</label>
            </div>
            <div class="col-lg-9">
                <input type="text" class="form-control" id="endpoint" name="apiEndpoint.endpoint" required />
            </div>
        </div>
        <div class="row padding-bottom-ten">
            <div class="col-lg-3 text-right">
                <label class="control-label">Method</label>
            </div>
            <div class="col-lg-9">
                <select id="method" required class="form-select" name="apiEndpoint.method">
                    <option value="GET">GET</option>
                    <option value="POST">POST</option>
                    <option value="PUT">PUT</option>
                </select>
            </div>
        </div>
        <div class="row padding-bottom-ten" id="mimeTypeRow" hidden>
            <div class="col-lg-3 text-right">
                <label class="control-label">MIME Type</label>
            </div>
            <div class="col-lg-9">
                <input type="text" class="form-control" id="mimeType" name="apiEndpoint.mimeType" required />
                <span class="field-validation-error" id="endpointMimeTypeRequired" hidden>Required</span>
            </div>
        </div>
        <div class="row"><div class="col-lg-12"><hr /></div></div>
        <table style="width:100%;margin-top:0;">
            <tr>
                <th>Parameter Mappings</th>
            </tr>
            <tbody id="parameterMappingRows"></tbody>
        </table>
        <span class="field-validation-error" id="endpointNoParameters" hidden>At least one parameter is required</span>
    </form>
</div>
<div class="modal-footer">
    <input type="button" id="button-field-search-cancel" class="btn btn-light" value="Cancel" data-action="cancel" />
    <input type="button" id="button-field-search-save" class="btn btn-primary" value="Save" data-action="save" />
</div>

<template id="parameterMappingRowTemplate">
    <tr data-mapping-index>
        <td>
            <div><hr /></div>
            <div class="row padding-bottom-ten">
                <div class="col-lg-3 text-right">
                    <label class="control-label">Parameter</label>
                </div>
                <div class="col-lg-7">
                    <input type="text" class="form-control cl-parameter" />
                </div>
                <div class="col-lg-2">
                    <button type="button" class="btn btn-light pull-right cl-delete-mapping" title="Delete" data-action="delete-mapping"><i class="fa fa-close"></i></button>
                </div>
            </div>
            <div class="row padding-bottom-ten">
                <div class="col-lg-3 text-right">
                    <label class="control-label">Maps To</label>
                </div>
                <div class="col-lg-7">
                    <select required class="form-select cl-event-data">
                        <option value="">Select property...</option>
                    </select>
                </div>
            </div>
        </td>
    </tr>
</template>
