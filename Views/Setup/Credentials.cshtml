@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}

<form class="form-horizontal" name="credentialsForm" novalidate>
    <h2><b>API Credentials</b></h2>
    <section>
        This step will allow you to set and test the API credentials that were set up in PlatformManagement.
        For assistance with creating your credentials in PlatformManagement, please click<a href="https://resources.elluciancloud.com/bundle/cl_platmnmgt_acn_use/page/c_pltform_mgmt_int_settings_cred_mgmt_intro.html" target="_blank">API Credentials Help.</a>
    </section>
    <hr>
    <div class="padding-top-ten">
        <div class="row form-group mb-3 cl-field">
            <label class="col-lg-2 control-label"><span class="form-required" aria-hidden="true">*</span> Username</label>
            <div class="col-lg-4">
                <input id="usernameInput" name="appSettingsSection.apiUsername" class="form-control" required />
            </div>
            <span class="field-validation-error cl-required">Required</span>
        </div>
        <div class="row form-group mb-3 cl-field">
            <label class="col-lg-2 control-label"><span class="form-required" aria-hidden="true">*</span> Password</label>
            <div class="col-lg-4">
                <input id="passwordInput" name="appSettingsSection.apiPassword" type="password" class="form-control" required />
            </div>
            <span class="field-validation-error cl-required">Required</span>
        </div>
        <div class="row form-group mb-3">
            <div class="col-lg-6">
                <div class="pull-right">
                    <span class="alert alert-success" role="alert" id="credentialsTestPassed" hidden>Connection Successful</span>
                    <span class="alert alert-danger" role="alert" id="credentialsTestFailed" hidden>Invalid Credentials</span>
                    <span class="alert alert-danger cl-step-error" role="alert" id="stepError" hidden></span>
                    <button id="testCredentialsButton" type="button" class="btn btn-light btn-lg">Test</button>
                </div>
            </div>
        </div>
    </div>
</form>

