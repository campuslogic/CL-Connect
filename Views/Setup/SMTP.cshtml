@{
    Layout = "~/Views/Shared/_LeftMenuLayout.cshtml";
}


<form class="form-horizontal" name="smtpForm" novalidate>
    <h2>
        <b>SMTP Setting</b>
    </h2>
    <p>
        These settings are used to send email notifications when errors occur in Cl Connect processes.
        For further detail on the SMTP section please click <a href="https://resources.elluciancloud.com/bundle/cl_integrations_acn_use/page/t_set_up_smtp.html" target="_blank">SMTP Settings Help</a>.
    </p>
    <hr>
    <div class="row padding-top-ten">
        <div class="col-lg-6">
            <div class="row form-group mb-3">
                <label class="col-lg-4 control-label"><span class="form-required" aria-hidden="true">* </span>Delivery Method</label>
                <div class="col-lg-8">
                    <select required class="form-select" name="smtpSection.deliveryMethod">
                        <option value="Network">Network</option>
                        <option value="PickupDirectoryFromIis">Pickup Directory From IIS</option>
                        <option value="SpecifiedPickupDirectory">Specified Pickup Directory</option>
                    </select>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="col-lg-4 control-label"><span class="form-required" aria-hidden="true">*</span> From</label>
                <div class="col-lg-8">
                    <input required id="from" name="smtpSection.from" type="email" class="form-control">
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="col-lg-4 control-label"><span class="form-required" aria-hidden="true">*</span> Send To</label>
                <div class="col-lg-8">
                    <input required name="campusLogicSection.smtpSettings.sendTo" type="text" class="form-control">
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div id="smtpNetworkLeft">
                <div class="row form-group mb-3">
                    <label class="col-lg-4 control-label">Client Domain</label>
                    <div class="col-lg-8">
                        <input name="smtpSection.network.clientDomain" type="text" class="form-control">
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label class="col-lg-4 control-label">Target Name</label>
                    <div class="col-lg-8">
                        <input name="smtpSection.network.targetName" type="text" class="form-control">
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label class="col-lg-4 control-label">Enable SSL</label>
                    <div class="col-lg-8 padding-top-seven">
                        <span>
                            <label><input type="radio" name="smtpSection.network.enableSsl" value="true" style="width: 20px">True</label>
                            <label><input type="radio" name="smtpSection.network.enableSsl" value="false" style="width: 20px">False</label>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row form-group mb-3" id="smtpPickupDirectory">
            <label class="col-lg-2 control-label"><span class="form-required" aria-hidden="true">*</span> Pick Up Directory Location</label>
            <div class="col-lg-4">
                <input required id="pickupDirectoryLocation" name="smtpSection.specifiedPickupDirectory.pickupDirectoryLocation" type="text" class="form-control">
                <span class="field-validation-error cl-required">Required</span>
            </div>
        </div>
        <div class="col-lg-6" id="smtpNetworkRight">
            <div class="row form-group mb-3">
                <label class="col-lg-4 control-label"><span class="form-required" aria-hidden="true">*</span> Host</label>
                <div class="col-lg-8">
                    <input required name="smtpSection.network.host" type="text" class="form-control">
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="col-lg-4 control-label"><span class="form-required" aria-hidden="true">*</span> Port</label>
                <div class="col-lg-8">
                    <input required name="smtpSection.network.port" type="text" class="form-control">
                    <span class="field-validation-error cl-required">Required</span>
                </div>
            </div>
            <div class="row form-group mb-3">
                <label class="col-lg-4 control-label"> <span class="form-required" aria-hidden="true">*</span> Default Credentials</label>
                <div class="col-lg-8 padding-top-seven">
                    <span>
                        <label><input type="radio" name="smtpSection.network.defaultCredentials" value="true" style="width: 20px">True</label>
                        <label><input type="radio" name="smtpSection.network.defaultCredentials" value="false" style="width: 20px">False</label>
                    </span>
                </div>
            </div>
            <div id="smtpNetworkCredentials">
                <div class="row form-group mb-3">
                    <label class="col-lg-4 control-label"><span class="form-required" aria-hidden="true"></span> User Name</label>
                    <div class="col-lg-8">
                        <input name="smtpSection.network.userName" type="text" class="form-control">
                    </div>
                </div>
                <div class="row form-group mb-3">
                    <label class="col-lg-4 control-label"><span class="form-required" aria-hidden="true"></span> Password</label>
                    <div class="col-lg-8">
                        <input name="smtpSection.network.password" type="password" class="form-control">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-12 padding-top-twenty">
        <button class="btn btn-light btn-lg next" type="button" id="testSmtpButton">Test</button>
        <span class="alert alert-success" role="alert" id="smtpTestPassed" hidden>Email sent successfully</span>
        <span class="alert alert-danger" role="alert" id="smtpTestFailed" hidden>Invalid smtp information</span>
        <span class="alert alert-danger cl-step-error" role="alert" id="stepError" hidden></span>
    </div>
</form>
