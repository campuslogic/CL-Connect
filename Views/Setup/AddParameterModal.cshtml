
<div class="modal-header"><h4 id="parameterModalTitle"></h4></div>
<div class="modal-body">
    <form id="parameterModalForm" novalidate>
        <div class="row padding-bottom-ten">
            <div class="col-lg-4 text-right">
                <label class="control-label">Name</label>
            </div>
            <div class="col-lg-8">
                <input type="text" class="form-control" id="inputFieldSize" name="parameter.name" required />
                <span class="field-validation-error" id="parameterNameRequired" hidden>Required</span>
                <span class="field-validation-error" id="parameterNameDuplicate" hidden>Two parameter names can not be the same.</span>
            </div>
        </div>
        <div class="row padding-bottom-ten">
            <div class="col-lg-4 text-right">
                <label class="control-label">Data Type</label>
            </div>
            <div class="col-lg-8">
                <select required class="form-select" name="parameter.dataType">
                    <option value="int">Int</option>
                    <option value="varchar">VARCHAR</option>
                    <option value="binary">Binary</option>
                    <option value="boolean">Boolean</option>
                    <option value="numeric">Numeric</option>
                    <option value="float">Float</option>
                    <option value="datetime">DateTime</option>
                    <option value="date">Date</option>
                    <option value="time">Time</option>
                </select>
                <span class="field-validation-error" id="parameterDataTypeRequired" hidden>Required</span>
            </div>
        </div>
        <div id="parameterLengthRow" class="row padding-bottom-ten" hidden>
            <div class="col-lg-4 text-right">
                <label class="control-label">Length:</label>
            </div>
            <div class="col-lg-8">
                <input name="parameter.length" type="number" class="form-control">
                <span class="field-validation-error" id="parameterLengthRequired" hidden>Required</span>
            </div>
        </div>
        <div class="row padding-bottom-ten">
            <div class="col-lg-4 text-right">
                <label class="control-label">Source Field</label>
            </div>
            <div class="col-lg-8">
                <select class="form-select" id="inputPropertyFieldValue" required name="parameter.source">
                </select>
                <span class="field-validation-error" id="parameterSourceRequired" hidden>Required</span>
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <input type="button" id="button-field-search-cancel" class="btn btn-light" value="Cancel" data-action="cancel" />
    <input type="button" id="button-field-search-save" class="btn btn-primary" value="Save" data-action="save" />
</div>
